# E-mail para recuperação de senha (opcional). Sem isso, o pedido
# aparece para o administrador na tela de Usuários.
# Exemplo com Gmail (use uma "senha de app", não a senha normal):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=suporte.sistemaodonto@gmail.com
SMTP_PASS=xoluaxvmjtvbkoha
