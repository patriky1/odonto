DATABASE_URL="file:./dev.db"
JWT_SECRET="odonto_secret_key_2024_very_secure"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Fuso horário da clínica (datas de "hoje", agenda e financeiro)
