# Copie este arquivo para ".env" e troque os valores.
# O .env NUNCA deve ir para o Git nem ser enviado a terceiros.

# Hoje o banco fica sempre em backend/dev.db (estas duas não são lidas pelo código atual)
DATABASE_URL="file:./dev.db"
JWT_EXPIRES_IN=7d
# Gere um valor longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Fuso horário da clínica (datas de "hoje", agenda e financeiro)
FUSO_HORARIO=America/Sao_Paulo

# Endereço do sistema (usado no link de "Esqueci minha senha").
APP_URL=http://localhost:5173

# E-mail para recuperação de senha (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------
# BACKUP DO BANCO
# ---------------------------------------------------------------
# Pasta dos backups (relativa à pasta backend/ ou caminho absoluto).
# Recomendado: outro disco ou uma pasta sincronizada com a nuvem.
# Padrão: backend/backups
BACKUP_DIR=
# Frequência inicial do backup automático, em horas (0 = desativado).
# Depois pode ser alterada pela tela Configurações > Backup.
BACKUP_INTERVALO_HORAS=24
# Quantos backups automáticos manter (os mais antigos são apagados)
BACKUP_MANTER=14
